# 复制为 .env；已设置的环境变量优先。无配置时可运行离线规则演示。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
DIDA_ACCESS_TOKEN=
# 腾讯配置以官方包 config.json 为准
TENCENT_MCP_URL=https://mcp.meeting.tencent.com/mcp/wemeet-open/v1
TENCENT_MEETING_TOKEN=
TENCENT_SKILL_VERSION=v1.0.15

# MCP 为首选；只用直连官方 API 时改为 api 并配置上方 DIDA_ACCESS_TOKEN
DIDA_BACKEND=mcp
DIDA_MCP_URL=https://mcp.dida365.com
DIDA_MCP_TRANSPORT=streamable_http
DIDA_MCP_AUTH=bearer
DIDA_MCP_BEARER_TOKEN=
# 兼容旧配置；bearer 模式下也按 Bearer 发送
DIDA_MCP_API_KEY=
# 先用连接页面「发现滴答工具」查看服务暴露的实际工具名与 schema
DIDA_MCP_PROJECTS_TOOL=
DIDA_MCP_CREATE_TOOL=
# 工具参数名 -> 标准任务字段名；空对象表示直接传标准 payload
# 例如 {"project_id":"projectId","title":"title","content":"content","due_date":"dueDate"}
# 若工具接收整个 task 对象，用 {"task":"$payload"}
DIDA_MCP_TASK_MAPPING={}
TENCENT_MCP_TRANSPORT=jsonrpc
# 可选观测：启用会向 LangSmith 发送节点和模型输入输出（含转写），默认关闭
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=meetmind
LLM_PROVIDER=custom

# 新会议分析策略：single 保留 V1；dual 启用核验与最多一次修正
MEETMIND_ANALYSIS_MODE=single
